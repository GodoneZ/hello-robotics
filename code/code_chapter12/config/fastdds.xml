<?xml version="1.0" encoding="UTF-8"?>
<!-- 本地仿真统一使用 UDP：避免连续启动/退出后残留 SHM 端口造成
     服务响应超时或部分 topic 单向失联。不影响 ROS_DOMAIN_ID 隔离。 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>chapter12_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="chapter12" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>chapter12_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
